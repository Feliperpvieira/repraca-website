---
// src/layouts/GaleriaLayout.astro
// Layout compartilhado por TODAS as páginas da galeria (/galeria e
// /galeria/praca/<slug>). Junta o que era duplicado entre os dois HTML
// antigos: <head>, header com logo, e o popup (modal) inteiro — que é
// idêntico nas duas páginas. Cada página só entra com o que é dela via
// <slot />.

import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const {
    title = "rePraça — reimagine sua praça",
    ogDescription = "Veja e crie praças reimaginadas no rePraça.",
    ogImage = "https://repraca.feliperpv.com/img/repraca-logo-horiz.png",
    description = ogDescription,
    canonical,
    stylesheet,
    stylesheets = [],
    // Só preenchidos pela página de uma praça específica
    // (src/pages/galeria/praca/[slug].astro). Viram data-attributes no
    // <body> pra o app.js ler sem precisar reler a URL — ver seção 1e
    // do app.js.
    pracaSlug,
    pracaNome,
} = Astro.props;

const cssFiles = [
    ...(stylesheet ? [stylesheet] : []),
    ...stylesheets
];
---

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Fallback genérico — a página de uma praça específica passa seu
         próprio title/description/canonical/ogImage já prontos. -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;700&display=swap" rel="stylesheet" />

    <!-- CSS adicional (páginas fora da galeria) -->
    {cssFiles.map((css: string) => (
        <link rel="stylesheet" href={css}>
    ))}

    <!-- Caminho ABSOLUTO de propósito: index e praça ficam em profundidades
         de URL diferentes (/galeria/ vs /galeria/praca/<slug>/), então um
         caminho relativo (ex: "css/style.css") quebraria numa das duas. -->
    <link rel="stylesheet" href="/galeria/css/style.css" />
</head>
<body data-praca-slug={pracaSlug} data-praca-nome={pracaNome}>
    <Header />

    <main class="container">
        <slot />

        
    </main>

    <Footer />

    <!-- O MODAL (POPUP) QUE ABRE VIA ?id= NA URL -->
    <div id="popup" class="escondido">
        <div class="popup-content">
            <button id="btnFecharModal" class="btn-fechar">X</button>

            <div class="popup-imagem-container">
                <img src="" alt="Vista da praça" id="selectedImage" />
                <div class="toggle-vista">
                    <button id="btnVistaTopo" class="btn-vista ativo" title="Vista de topo">
                        <svg xmlns="http://www.w3.org/2000/svg" width="27" height="40" viewBox="0 0 27 40" fill="none">
                            <path d="M3.375 26.6667C1.512 26.6667 4.44159e-07 25.1733 5.24588e-07 23.3333L1.39882e-06 3.33333C1.47932e-06 1.49167 1.512 -1.11412e-06 3.375 -1.03268e-06L23.625 -1.47526e-07C25.488 -6.60916e-08 27 1.49167 27 3.33333L27 23.3333C27 25.1733 25.488 26.6667 23.625 26.6667L3.375 26.6667ZM21.9995 40C23.805 40 24.6863 37.7967 23.3788 36.5516L17.078 30.5516C16.7061 30.1975 16.2123 30 15.6988 30L11.3012 30C10.7877 30 10.2939 30.1975 9.92202 30.5516L3.62123 36.5516C2.31374 37.7967 3.19497 40 5.00045 40L21.9995 40Z" fill="#F9EFE7"/>
                        </svg>
                    </button>
                    <button id="btnVistaAngulo" class="btn-vista" title="Vista de ângulo">
                        <svg xmlns="http://www.w3.org/2000/svg" width="45" height="39" viewBox="0 0 45 39" fill="none">
                        <path d="M23.551 32.5689C22.6195 34.1823 20.5703 34.745 18.9768 33.825L1.65628 23.825C0.0613534 22.9042 -0.474468 20.849 0.457032 19.2355L10.582 1.69853C11.5135 0.0851261 13.5614 -0.478471 15.1563 0.442362L32.4768 10.4424C34.0703 11.3624 34.6075 13.4185 33.676 15.0319L23.551 32.5689ZM44.4103 23.1062C45.3131 21.5426 43.8456 19.6778 42.1136 20.1876L33.767 22.6442C33.2744 22.7892 32.8564 23.1181 32.5997 23.5629L30.4009 27.3712C30.1442 27.8159 30.0683 28.3424 30.189 28.8415L32.2348 37.2981C32.6593 39.053 35.008 39.3915 35.9108 37.8279L44.4103 23.1062Z" fill="#0A6EB6"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="popup-sidebar">
                <div class="sidebar-topo">
                    <p class="praca-numero" id="modalNumero">rePraça</p>
                    <h2 id="modalTitulo">Carregando...</h2>
                    <p class="praca-base" id="modalBaseadoEm"></p>
                    <p id="modalData" class="texto-dica"></p>

                    <div class="popup-acoes">
                        <button id="btnLikeModal" class="btn-like">
                            <span id="modalLikesCount">0</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="33" viewBox="0 0 36 33" fill="none">
                                <path d="M9.4212 0C4.6476 0 0 3.35317 0 9.49117C0 16.3203 7.821 23.6573 16.7454 32.4812C17.0946 32.8277 17.5482 33 18 33C18.4518 33 18.9054 32.8277 19.2546 32.4812C28.2132 23.6243 36 16.3222 36 9.49117C36 3.344 31.356 0.0165001 26.5878 0.0165001C23.283 0.0165001 20.025 1.60417 18 4.69883C15.966 1.5895 12.717 0 9.4212 0Z" fill="#B76F51" />
                            </svg>
                        </button>
                        <a href="#" id="btnRemix" class="btn-remix">
                            reMixar praça
                            <img src="/img/icone-lapis.png" width="54" height="54" />
                        </a>
                    </div>
                </div>

                <div class="tabs-container">
                    <div class="tabs-header">
                        <button class="tab-btn tab-itens ativo" data-tab="itens">info</button>
                        <button class="tab-btn tab-remixes" data-tab="remixes">remixes</button>
                        <button class="tab-btn tab-historico" data-tab="historico" id="btnTabHistorico">histórico</button>
                    </div>

                    <div class="tabs-conteudo tabs-conteudo--itens">
                        <div class="tab-painel ativo" id="painelItens">
                            <div class="estatisticas">
                                <div class="stat-box">
                                    <span id="modalTotalItens" class="stat-numero">-</span>
                                    <span class="stat-label">Itens</span>
                                </div>
                                <div class="stat-box">
                                    <span id="modalCategoria" class="stat-numero">-</span>
                                    <span class="stat-label">Foco</span>
                                </div>
                            </div>
                            <p id="modalComentario" class="comentario-praca"></p>

                            <div class="radar-container">
                                <canvas id="radarPraca"></canvas>
                            </div>

                            <div id="modalListaItens" class="lista-categorias">
                                <!-- O JS injeta aqui os grupos por categoria -->
                            </div>
                        </div>

                        <div class="tab-painel" id="painelRemixes">
                            <div id="listaRemixes" class="lista-remixes"></div>
                        </div>

                        <div class="tab-painel" id="painelHistorico">
                            <div id="listaHistorico" class="lista-historico"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Import do Supabase -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
    <!-- Chart.Js pras tabelas no popup de cada praça -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4" is:inline></script>
    <!-- Caminho absoluto pelo mesmo motivo do CSS acima -->
    <script src="/galeria/js/app.js" is:inline></script>
</body>
</html>
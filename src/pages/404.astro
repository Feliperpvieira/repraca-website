---
import Layout from '../layouts/layout.astro';
import Download from '../components/logo-download.astro';
---

<Layout
    title="Erro 404 - rePraça"
    description="Página não encontrada."
    canonical="https://repraca.feliperpv.com/404/"
    stylesheets={[
        "/css/index.css",
        "/css/privacidade.css"
    ]}
>

   <main>

            <section class="politica">

                <h1 class="texto-azul">Erro 404</h1>

                <h2 class="texto-marrom" style="text-align: center; margin-top: 10px;">Esta praça foi imaginada em outro lugar :(</h2>

                <p class="texto-centro" style="margin: 32px 0 72px 0; font-size: 1.2rem;"><a class="texto-azul" href="/">Voltar para a tela inicial</a></p>
            </section>

            <p class="texto-centro">Acredita que este erro não deveria ter ocorrido?</p>
            <p class="texto-centro">Entre em contacto pelo <a class="texto-azul" href="mailto:repraca@feliperpv.com">repraca@feliperpv.com</a></p>
    
            
            <Download />

        </main>
</Layout>
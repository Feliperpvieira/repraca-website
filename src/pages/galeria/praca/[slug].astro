---
// src/pages/galeria/praca/[slug].astro
//
// Gera uma página ESTÁTICA por praça-base, uma pra cada arquivo em
// public/galeria/dados/pracas/*.json — no build, não em runtime. Por
// isso o nome, a descrição e a contagem de itens originais já saem
// prontos no HTML (funcionam até com JS desligado); só a média das
// reimaginações e a grade de cards continuam dependendo do Supabase
// (isso sim é dado vivo, não dá pra "travar" no build).
//
// Os arquivos continuam em public/ (não em src/data/) de propósito: o
// popup de cada criação individual também busca esse mesmo JSON em
// runtime via fetch (pra comparar UMA reimaginação com o original) — não
// faz sentido manter os dados duplicados em dois lugares.

import fs from "node:fs";
import path from "node:path";
import GaleriaLayout from "../../../layouts/GaleriaLayout.astro";

export async function getStaticPaths() {
  const PASTA_PRACAS = path.resolve("./public/galeria/dados/pracas");

  const arquivos = fs.readdirSync(PASTA_PRACAS).filter(arquivo => arquivo.endsWith('.json'));

  return arquivos.map(arquivo => {
    const slug = arquivo.replace(/\.json$/, '');
    const dados = JSON.parse(fs.readFileSync(path.join(PASTA_PRACAS, arquivo), 'utf-8'));
    return { params: { slug }, props: { slug, dados } };
  });
}


const { slug, dados } = Astro.props;
const itensOriginais = dados.itens || {};
---
<GaleriaLayout
    title={`${dados.nome} — rePraça`}
    ogDescription={`Veja as reimaginações da praça ${dados.nome} no rePraça.`}
    canonical={`https://repraca.feliperpv.com/galeria/praca/${slug}/`}
    pracaSlug={slug}
    pracaNome={dados.nome}

    stylesheets={[
        "/css/index.css",
        "/css/privacidade.css"
    ]}
>
    <!-- Itens originais embutidos pro app.js montar o radar comparativo,
         sem precisar de um fetch extra (os dados já estão aqui no HTML). -->
    <script type="application/json" id="dados-itens-originais" set:html={JSON.stringify(itensOriginais)} />

    <!-- CABEÇALHO DA PRAÇA-BASE — nome, descrição e contagem original
         renderizados aqui mesmo pelo Astro (funcionam sem JS). Só os
         dois stat-boxes de baixo (média/reimaginações) e o radar
         dependem do Supabase, preenchidos pelo app.js depois. -->
    <section class="praca-cabecalho">
        <!-- Localização (badge que abre o Google Maps) + nome, e o botão
             "Reimaginar na app". No mobile o botão fica fixo no fundo da
             tela (ver style.css) — a posição dele aqui no HTML não importa
             mais nesse caso, mas mantemos ele aqui pra ordem de leitura/
             tab fazer sentido em quem usa teclado ou leitor de tela.

             ATENÇÃO: o link usa "?mapa=" (mapaId), não "?id=" (que é o
             formato usado hoje só pra remixar UMA criação existente). O
             DeepLinkManager.cs do app Unity ainda não trata "?mapa=" —
             isso precisa ser adicionado lá pro botão funcionar de facto. -->
        <div class="praca-topo">
            <div class="praca-local">
                {dados.mapsUrl && (
                    <a
                        class="praca-local-badge"
                        href={dados.mapsUrl}
                        target="_blank"
                        rel="noopener"
                        aria-label={`Ver ${dados.nome} no Google Maps`}
                    >
                        <img src="/img/icone-mapa.svg" alt="" width="32" height="32" />
                    </a>
                )}

                <div class="praca-local-texto">
                    {(dados.bairro || dados.cidade) && (
                        <span class="praca-local-nome">
                            {[dados.bairro, dados.cidade].filter(Boolean).join(", ")}
                        </span>
                    )}
                    <h1>{dados.nome}</h1>
                </div>
            </div>

            <!-- .btn-remix é o MESMO botão já usado dentro do popup de cada
                 criação (ver .popup-acoes no style.css) — reaproveitado aqui
                 tal e qual, só com href/texto diferentes. O flex:1 dele (que
                 só faz sentido ao lado do botão de curtir, lá no popup) é
                 anulado logo abaixo, em ".praca-topo .btn-remix". -->
            <a href={`https://feliperpv.com/repraca/galeria/abrir-app/?mapa=${slug}`} class="btn-remix">
                Reimaginar na app<img src="/img/icone-lapis.png" width="54" height="54" alt="" />
            </a>
        </div>

        <!-- Bio + fotos (mapa/satélite e foto no local) lado a lado no
             desktop; no mobile as fotos viram uma faixa com scroll
             horizontal, cada uma ocupando ~80% da largura (ver style.css). -->
        <div class="praca-media">
            {dados.descricao && <div class="praca-intro" set:html={dados.descricao} />}

            {dados.imagens?.length > 0 && (
                <div class="praca-fotos">
                    {dados.imagens.map(imagem => (
                        <figure class="praca-foto">
                            <img src={imagem.src} alt={imagem.alt || ""} loading="lazy" />
                            {imagem.legenda && <figcaption>{imagem.legenda}</figcaption>}
                        </figure>
                    ))}
                </div>
            )}
        </div>

        <div class="praca-comparativo">
            <div class="radar-container">
                <canvas id="radarComparativoPraca"></canvas>
            </div>

            <!-- Desktop: o botão vira só o título "Mudanças por item:" e a lista
                 fica sempre aberta ao lado do radar, com scroll próprio.
                 Mobile: vira o dropdown (seta ▾) abaixo do radar. -->
            <div class="praca-lista-painel">
                <button
                    type="button"
                    class="toggle-lista-itens"
                    aria-expanded="false"
                    aria-controls="pracaListaItensWrapper"
                >
                    <span class="toggle-texto">Mudanças por item</span>
                    <span class="toggle-seta" aria-hidden="true">▾</span>
                </button>

                <div id="pracaListaItensWrapper" class="lista-itens-wrapper">
                    <div id="pracaListaItens" class="lista-categorias"></div>
                </div>
            </div>
        </div>

        <!-- Mesmo #statTotal que já existia no stat-box removido — o app.js
             não precisou mudar, só o innerText dele agora aparece aqui. -->
        <p class="praca-amostra">Média com base em <span id="statTotal">-</span> rePraças</p>
    </section>

    <!-- BARRA DE FILTROS — filtra só dentro das reimaginações desta
         praça-base (carregarPracas() em app.js usa data-praca-nome
         do <body> pra isso). -->
    <section class="filtros-container">
        <div class="filtro-grupo">
            <label for="filtroOrdem">Ordenar por:</label>
            <select id="filtroOrdem">
                <button><selectedcontent></selectedcontent></button>
                <option value="recentes">Mais Recentes</option>
                <option value="antigas">Mais Antigas</option>
                <option value="likes">Mais Likes</option>
            </select>
        </div>

        <div class="filtro-grupo">
            <label for="filtroEspecifico">Contém o item:</label>
            <select id="filtroEspecifico">
                <button>
                    <selectedcontent></selectedcontent>
                </button>
                <option value="todos">Todos</option>
            </select>
        </div>

        <!-- Slider de 0 a 30 (30 = "30 ou mais") no lugar do antigo <select>
             de 3 opções fixas. A quantidade de itens varia bastante entre
             praças, então faz mais sentido deixar o usuário explorar a
             faixa livremente do que travar em degraus fixos. Começa em 3
             pra esconder as praças vazias por padrão, igual o comportamento
             antigo. A busca só dispara ao SOLTAR o slider ("change"), não a
             cada pixel arrastado ("input") — igual os outros filtros, que
             não têm busca ao vivo (ver app.js, seção 3). -->
        <div class="filtro-grupo filtro-grupo--slider">
            <label for="filtroItens">
                Mínimo de itens: <span id="filtroItensValor">3+</span>
            </label>
            <input type="range" id="filtroItens" min="0" max="30" step="1" value="3">
        </div>

        <!-- Os dois "sim/não" (remix, descrição) viraram switches lado a
             lado sob um título comum — mais compacto que dois grupos
             separados e deixa claro que ambos filtram o MESMO tipo de
             coisa (o que é mostrado na grid, não como ela é ordenada). -->
        <div class="filtro-grupo filtro-grupo--toggles">
            <span class="filtro-grupo__titulo">Mostrar praças:</span>
            <div class="toggles-lista">
                <label class="toggle-switch">
                    <input type="checkbox" id="filtroSoRemixes">
                    <span class="toggle-trilho" aria-hidden="true"></span>
                    <span class="toggle-texto">Só reMixes</span>
                </label>
                <label class="toggle-switch">
                    <input type="checkbox" id="filtroComDescricao">
                    <span class="toggle-trilho" aria-hidden="true"></span>
                    <span class="toggle-texto">Só com descrição</span>
                </label>
            </div>
        </div>
    </section>

    <!-- A GRID ONDE OS CARDS VÃO APARECER — só as reimaginações DESTA praça -->
    <section id="gallery" class="grid-galeria"></section>

    <!-- OBSERVADOR PARA O SCROLL INFINITO -->
    <div id="fim-da-pagina" class="loading-spinner">A carregar mais praças...</div>
</GaleriaLayout>

<script>
  const btnToggle = document.querySelector<HTMLButtonElement>('.toggle-lista-itens');
  const wrapper = document.getElementById('pracaListaItensWrapper');

  // No desktop a lista fica sempre aberta (o CSS força isso) e o botão é só um
  // título; o dropdown só existe no mobile. Mesmo breakpoint do style.css.
  const desktop = window.matchMedia('(min-width: 769px)');

  function sincronizarComBreakpoint() {
    if (!btnToggle) return;
    if (desktop.matches) {
      btnToggle.setAttribute('aria-expanded', 'true');
      btnToggle.tabIndex = -1;
    } else {
      btnToggle.setAttribute('aria-expanded', String(wrapper?.classList.contains('aberto') ?? false));
      btnToggle.tabIndex = 0;
    }
  }

  sincronizarComBreakpoint();
  desktop.addEventListener('change', sincronizarComBreakpoint);

  btnToggle?.addEventListener('click', () => {
    if (desktop.matches) return;
    const expandido = btnToggle.getAttribute('aria-expanded') === 'true';
    btnToggle.setAttribute('aria-expanded', String(!expandido));
    wrapper?.classList.toggle('aberto', !expandido);
  });
</script>
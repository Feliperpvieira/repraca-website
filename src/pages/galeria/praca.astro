---
// src/pages/galeria/praca.astro
// Continua recebendo a praça-base via query string (?praca=<slug>), do
// mesmo jeito que já estava — o app.js já sabe ler isso. Não virou rota
// dinâmica (/galeria/praca/[slug]) de propósito: as praças-base vivem em
// JSON estático servido em runtime, não em algo que o Astro precise saber
// em tempo de build.
import GaleriaLayout from "../../layouts/GaleriaLayout.astro";
---
<GaleriaLayout 
    title="rePraça — Galeria da Praça"
    description="Galeria da praça X."
    canonical="https://repraca.feliperpv.com/galeria/praca/"
    stylesheets={[
        "/css/index.css",
        "/css/privacidade.css"
    ]}>
    
    <!-- CABEÇALHO DA PRAÇA-BASE — preenchido via app.js a partir de
         /galeria/dados/pracas/<slug>.json (nome, descricao, itens originais)
         e de uma agregação de todas as reimaginações no Supabase. -->
    <section class="praca-cabecalho">
        <h1 id="pracaTitulo">A carregar...</h1>
        <div id="pracaIntro" class="praca-intro"></div>

        <div class="estatisticas-praca">
            <div class="stat-box">
                <span id="statOriginal" class="stat-numero">-</span>
                <span class="stat-label">Itens na praça original</span>
            </div>
            <div class="stat-box">
                <span id="statMedia" class="stat-numero">-</span>
                <span class="stat-label">Média por reimaginação</span>
            </div>
            <div class="stat-box">
                <span id="statTotal" class="stat-numero">-</span>
                <span class="stat-label">Reimaginações</span>
            </div>
        </div>

        <div class="praca-comparativo">
            <div class="radar-container">
                <canvas id="radarComparativoPraca"></canvas>
            </div>
            <div id="pracaListaItens" class="lista-categorias"></div>
        </div>
    </section>

    <!-- BARRA DE FILTROS (mesma da galeria geral — aqui só filtra
         dentro das reimaginações desta praça-base) -->
    <section class="filtros-container">
        <div class="filtro-grupo">
            <label for="filtroOrdem">Ordenar por:</label>
            <select id="filtroOrdem">
                <option value="recentes">Mais Recentes</option>
                <option value="antigas">Mais Antigas</option>
                <option value="likes">Mais Likes</option>
            </select>
        </div>

        <div class="filtro-grupo">
            <label for="filtroItens">Mínimo de itens:</label>
            <select id="filtroItens">
                <option value="3" selected>Pelo menos 3 (Ocultar vazias)</option>
                <option value="10">Mais de 10 itens</option>
                <option value="0">Mostrar Todas</option>
            </select>
        </div>

        <div class="filtro-grupo">
            <label for="filtroEspecifico">Contém o item:</label>
            <select id="filtroEspecifico">
                <button>
                    <selectedcontent></selectedcontent>
                </button>
                <option value="todos">Qualquer item</option>
            </select>
        </div>
    </section>

    <!-- A GRID ONDE OS CARDS VÃO APARECER -->
    <section id="gallery" class="grid-galeria"></section>

    <!-- OBSERVADOR PARA O SCROLL INFINITO -->
    <div id="fim-da-pagina" class="loading-spinner">A carregar mais praças...</div>
</GaleriaLayout>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repraca-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/galeria/*"]
  }
}
